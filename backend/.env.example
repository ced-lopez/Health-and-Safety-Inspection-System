APP_NAME="Barangay 178 Health and Safety Inspection"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (must match docker-compose.yml defaults)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=health_safety_inspection
DB_USERNAME=health_safety
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret_root

# Sanctum Token Expiration (minutes, 43200 = 30 days, 0 = never)
SANCTUM_TOKEN_EXPIRATION_MINUTES=43200
# Staff/Admin/Inspector single-session: 480 min (8h) absolute expiry, per-role
SANCTUM_STAFF_EXPIRATION_MINUTES=480
# Staff idle timeout (last_used_at) — 60 min; Sanctum tracks via middleware
SANCTUM_STAFF_IDLE_MINUTES=60

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Use Mailpit or another local SMTP inbox during development. Do not use the
# log mailer for password resets because reset links contain a secret token.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@barangay178.gov.ph"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend (React + Vite)
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Sanctum SPA authentication
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,localhost:5174,127.0.0.1,127.0.0.1:5173,127.0.0.1:5174

VITE_APP_NAME="${APP_NAME}"

TESSERACT_BINARY=
TESSERACT_LANG=eng
GHOSTSCRIPT_BINARY=gswin64c
OCR_ENHANCEMENT_ENABLED=true
OCR_PDF_DPI=300
OCR_STORAGE_DISK=public
OCR_CONFIDENCE_LOW_THRESHOLD=0.75
OCR_CONFIDENCE_MEDIUM_THRESHOLD=0.9
OCR_FIELD_COMPLETENESS_THRESHOLD=0.5
OCR_MAX_FILE_SIZE_KB=10240
OCR_ALLOWED_MIMES=pdf,jpg,jpeg,png,webp

# OCR engine
OCR_OEM=3
OCR_DEFAULT_PSM=3
OCR_PSM_MODES=6,11,12
OCR_MAX_PASSES=6
OCR_EARLY_EXIT_ENABLED=true
OCR_EARLY_EXIT_SCORE=7.5

# Image preprocessing (GD). The original upload is never modified.
OCR_PREPROCESS_ENABLED=true
OCR_AUTO_ORIENT=true
OCR_UPSCALE_ENABLED=true
OCR_MIN_WIDTH=1200
OCR_MAX_DIMENSION=4000
OCR_GRAYSCALE_ENABLED=true
OCR_CONTRAST_ENABLED=true
OCR_DENOISE_ENABLED=true
OCR_ADAPTIVE_THRESHOLD_ENABLED=true
OCR_SHARPEN_ENABLED=true
OCR_THRESHOLD_WINDOW=21
OCR_THRESHOLD_OFFSET=8

# Region-based OCR for complex ID layouts
OCR_REGION_OCR_ENABLED=true
OCR_REGION_MIN_LABEL_CONFIDENCE=55
OCR_REGION_CROP_PADDING=10
OCR_REGION_PSM=7

# Offline accuracy evaluation (php artisan ocr:evaluate)
# OCR_EVALUATION_IMAGES=storage/app/ocr-evaluation/images
# OCR_EVALUATION_MANIFEST=storage/app/ocr-evaluation/manifest.json
# OCR_EVALUATION_RESULT=storage/app/ocr-evaluation/report.json


